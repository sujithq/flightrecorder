{
  "name": "flight-recorder",
  "displayName": "Agent Flight Recorder",
  "description": "Build and run a local Flight Recorder with Docker, connect its MCP tools, and inspect agent traces in VS Code.",
  "version": "0.2.0",
  "publisher": "sujithq",
  "license": "MIT",
  "engines": { "vscode": "^1.101.0" },
  "categories": ["Visualization", "Other"],
  "repository": { "type": "git", "url": "https://github.com/sujithq/flightrecorder.git", "directory": "extensions/flight-recorder" },
  "main": "./extension.cjs",
  "extensionKind": ["workspace"],
  "activationEvents": ["onMcpServerDefinitionProvider:flightRecorder.local"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "The recorder connects to local services and can explicitly build and manage a Docker installation." },
    "virtualWorkspaces": { "supported": false }
  },
  "contributes": {
    "commands": [
      { "command": "flightRecorder.open", "title": "Open Recorder", "category": "Flight Recorder", "icon": "$(pulse)" },
      { "command": "flightRecorder.openRun", "title": "Select Run", "category": "Flight Recorder" },
      { "command": "flightRecorder.setup", "title": "Set Up Local Recorder", "category": "Flight Recorder" },
      { "command": "flightRecorder.start", "title": "Start Local Recorder", "category": "Flight Recorder" },
      { "command": "flightRecorder.stop", "title": "Stop Local Recorder", "category": "Flight Recorder" },
      { "command": "flightRecorder.restart", "title": "Restart Local Recorder", "category": "Flight Recorder" },
      { "command": "flightRecorder.rebuild", "title": "Rebuild / Update Local Recorder", "category": "Flight Recorder" },
      { "command": "flightRecorder.configureRestart", "title": "Configure Restart with Docker", "category": "Flight Recorder" },
      { "command": "flightRecorder.status", "title": "Show Local Recorder Status", "category": "Flight Recorder" },
      { "command": "flightRecorder.logs", "title": "Show Local Recorder Logs", "category": "Flight Recorder" },
      { "command": "flightRecorder.dockerGuide", "title": "Docker Installation Guide", "category": "Flight Recorder" },
      { "command": "flightRecorder.connectCopilot", "title": "Connect to Copilot", "category": "Flight Recorder" },
      { "command": "flightRecorder.disconnectCopilot", "title": "Disconnect from Copilot", "category": "Flight Recorder" }
    ],
    "mcpServerDefinitionProviders": [
      { "id": "flightRecorder.local", "label": "Flight Recorder (local)" }
    ],
    "walkthroughs": [
      {
        "id": "flightRecorder.localSetup",
        "title": "Set up your local Flight Recorder",
        "description": "Build the bundled recorder with Docker, preserve traces locally, and optionally connect Copilot.",
        "steps": [
          {
            "id": "docker",
            "title": "Prepare Docker",
            "description": "Install Docker with Compose v2 and start its Linux-container engine. No host .NET, Node.js, or Git is needed.\n[Docker installation guide](command:flightRecorder.dockerGuide)",
            "media": { "markdown": "media/setup.md" },
            "completionEvents": ["onContext:flightRecorder.dockerReady"]
          },
          {
            "id": "setup",
            "title": "Build and run the bundled recorder",
            "description": "Review the port, storage, downloads, and optional restart setting before anything is installed.\n[Set Up Local Recorder](command:flightRecorder.setup)",
            "media": { "markdown": "media/setup.md" },
            "completionEvents": ["onContext:flightRecorder.ready"]
          },
          {
            "id": "copilot",
            "title": "Optionally connect Copilot",
            "description": "Publish the local MCP endpoint without editing your workspace configuration. VS Code retains trust and tool approvals.\n[Connect to Copilot](command:flightRecorder.connectCopilot)",
            "media": { "markdown": "media/setup.md" },
            "completionEvents": ["onContext:flightRecorder.mcpConnected"]
          }
        ]
      }
    ],
    "configuration": {
      "title": "Flight Recorder",
      "properties": {
        "flightRecorder.serverUrl": {
          "type": "string",
          "default": "http://localhost:5080",
          "scope": "machine",
          "restricted": true,
          "description": "Local recorder origin. Only localhost, 127.0.0.1 and ::1 are accepted. Remote workspaces use VS Code port forwarding."
        }
      }
    }
  },
  "files": ["extension.cjs", "webview.cjs", "setup.cjs", "mcp.cjs", "docker-process.cjs", "local-recorder.cjs", "media/setup.md", "recorder/**", "README.md", "LICENSE"]
}