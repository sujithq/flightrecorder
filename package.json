{
  "name": "agent-flight-recorder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "node --test tests/web/*.test.mjs tests/integrations/*.test.mjs",
    "squad": "squad",
    "squad:check": "squad doctor",
    "build:web": "node scripts/build-web.mjs",
    "test:web": "node --test tests/web/*.test.mjs",
    "test:integrations": "node --test tests/integrations/*.test.mjs",
    "package:vscode": "node scripts/package-extension.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:tag": "node scripts/release.mjs tag",
    "github:summary": "node scripts/github-check.mjs",
    "badger": "node scripts/badger-bridge.mjs",
    "test:badger": "python -m unittest discover -s tests/badger -v",
    "test:persistence": "node --test tests/containers/persistence.test.mjs",
    "test:vsix-setup": "node --test tests/containers/vsix-setup.test.mjs",
    "pretest:e2e": "npm run build:web",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@bradygaster/squad-cli": "0.13.0",
    "@github/copilot": "1.0.83",
    "@playwright/test": "1.63.0",
    "@types/vscode": "1.134.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "lucide": "1.37.0",
    "serialport": "13.0.0"
  }
}
